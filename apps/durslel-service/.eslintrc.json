{
  "extends": [
    "../../.eslintrc.json"
  ],
  "ignorePatterns": [
    "!**/*",
    "drizzle",
    "src/types/generated.ts"
  ],
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "rules": {}
    },
    {
      "files": [
        "specs/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-non-null-assertion": "off"
      }
    }
  ]
}
