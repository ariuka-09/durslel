{
  "name": "durslel-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/durslel-service/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:durslel"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx wrangler dev"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/durslel-service/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/durslel-service/jest.config.ts",
        "codeCoverage": true
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "graphql-codegen --config ./apps/durslel-service/codegen.yml"
        ]
      }
    },
    "drizzle:generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx drizzle-kit generate --config=drizzle.config.ts"
      }
    },
    "drizzle:studio": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx drizzle-kit studio --port 3006 --verbose --config=drizzle.config.ts"
      }
    },
    "execute-d1-testing": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx wrangler d1 migrations apply dursel-db-test --env test --remote"
      }
    },
    "execute-d1-prod": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx wrangler d1 migrations apply dursel-db --env production --remote"
      }
    },
    "deploy-test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx wrangler deploy --env test"
      }
    },
    "deploy-prod": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx wrangler deploy --env production"
      }
    },
    "schema-print": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx apps/durslel-service/src/scripts/print-schema.ts"
      }
    },
    "put-secrets-test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx wrangler secret bulk secrets.json --env test"
      }
    },
    "put-secrets-prod": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/durslel-service",
        "command": "npx wrangler secret bulk secrets.json --env production"
      }
    }
  }
}
